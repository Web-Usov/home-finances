{
  "name": "family-budget",
  "private": true,
  "version": "0.1.0",
  "description": "Family budget monorepo: NestJS backend + Expo frontend",
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "api:generate": "turbo run build --filter=@family-budget/types && pnpm --filter @family-budget/api openapi && pnpm --filter @family-budget/mobile orval",
    "api:contract": "node scripts/api-contract.mjs",
    "e2e:smoke": "node scripts/with-lock.mjs e2e -- pnpm e2e:smoke:run",
    "e2e:full": "node scripts/with-lock.mjs e2e -- pnpm e2e:full:run",
    "e2e:smoke:run": "turbo run build --filter=@family-budget/api && pnpm --filter @family-budget/e2e test:smoke",
    "e2e:full:run": "turbo run build --filter=@family-budget/api && pnpm --filter @family-budget/e2e test:full",
    "smoke:compose": "bash scripts/smoke-compose.sh",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs quick",
    "spec:check": "node scripts/spec-check.mjs",
    "tasks:check": "node scripts/tasks.mjs check && node scripts/tasks.mjs board --check",
    "tasks:board": "node scripts/tasks.mjs board",
    "tasks:next": "node scripts/tasks.mjs next",
    "tasks:set": "node scripts/tasks.mjs set",
    "task:start": "node scripts/task-start.mjs",
    "task:clean": "node scripts/task-clean.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:reset": "pnpm --filter api prisma migrate reset --force",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^1.10.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
