{
  "extends": "@family-budget/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "support/**/*.mjs"],
  "exclude": ["node_modules", "playwright-report", "test-results", ".web"]
}
