[Unit]
Description=Family Budget preview: deploy new origin/master if any
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=@PREVIEW_HOME@/preview.env
Environment=PATH=@PATH@
ExecStart=@PREVIEW_HOME@/current/scripts/preview/update.sh
# A build can wait for the machine-wide heavy-job lock (e2e runs), so no short timeout.
TimeoutStartSec=3h
Nice=19
IOSchedulingClass=idle
