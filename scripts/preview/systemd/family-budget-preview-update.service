[Unit]
Description=Family Budget preview: deploy new origin/master if any
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=@PREVIEW_HOME@/preview.env
Environment=PATH=@PATH@
ExecStart=@PREVIEW_HOME@/current/scripts/preview/update.sh
# A build can wait for the machine-wide heavy-job lock (e2e runs), so no short timeout.
TimeoutStartSec=3h
Nice=19
IOSchedulingClass=idle
# Only NoNewPrivileges: the updater needs the shared /tmp (machine-wide e2e lock), docker, systemctl, ssh keys and the
# pnpm store, so a stricter sandbox would break it.
NoNewPrivileges=yes
