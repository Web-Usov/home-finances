[Unit]
Description=Family Budget preview API (port 3100, DB family_budget_preview)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
EnvironmentFile=@PREVIEW_HOME@/preview.env
Environment=NODE_ENV=production
WorkingDirectory=@PREVIEW_HOME@/current/apps/api
ExecStart=@NODE@ dist/main.js
Restart=on-failure
RestartSec=5
MemoryMax=768M
Nice=5
# Hardening. Runs as root because the preview lives under /root/workspace (mode 700), so ProtectHome and a dedicated
# user are not possible without moving it; the filesystem is read-only instead.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@PREVIEW_HOME@/state
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
