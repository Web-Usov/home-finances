{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_health_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/months": {
      "get": {
        "operationId": "MonthsController_list_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of budget months"
          }
        },
        "summary": "List months and statuses",
        "tags": [
          "Months"
        ]
      },
      "post": {
        "operationId": "MonthsController_create_v1",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created month"
          }
        },
        "summary": "Create first or next month",
        "tags": [
          "Months"
        ]
      }
    },
    "/api/v1/months/{period}": {
      "patch": {
        "operationId": "MonthsController_updateIncome_v1",
        "parameters": [
          {
            "name": "period",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "income": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "income",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated month summary and warnings"
          },
          "404": {
            "description": "MONTH_NOT_FOUND"
          },
          "409": {
            "description": "VERSION_CONFLICT or MONTH_LOCKED"
          },
          "422": {
            "description": "ALLOCATION_EXCEEDS_INCOME or VALIDATION_ERROR"
          }
        },
        "summary": "Change income for a month",
        "tags": [
          "Months"
        ]
      }
    },
    "/api/v1/months/{period}/close": {
      "post": {
        "operationId": "MonthsController_close_v1",
        "parameters": [
          {
            "name": "period",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New statuses of current and draft months"
          }
        },
        "summary": "Close an open month",
        "tags": [
          "Months"
        ]
      }
    },
    "/api/v1/months/{period}/reopen": {
      "post": {
        "operationId": "MonthsController_reopen_v1",
        "parameters": [
          {
            "name": "period",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recalculation range and status"
          }
        },
        "summary": "Reopen a closed month",
        "tags": [
          "Months"
        ]
      }
    },
    "/api/v1/envelopes": {
      "get": {
        "operationId": "EnvelopesController_list_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of envelopes with balances"
          }
        },
        "summary": "Get list of envelopes",
        "tags": [
          "Envelopes"
        ]
      },
      "post": {
        "operationId": "EnvelopesController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "initialBalance": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created envelope with calculated balance"
          },
          "409": {
            "description": "ENVELOPE_NAME_DUPLICATE or MONTH_LOCKED"
          }
        },
        "summary": "Create a new envelope",
        "tags": [
          "Envelopes"
        ]
      }
    },
    "/api/v1/envelopes/{id}": {
      "patch": {
        "operationId": "EnvelopesController_update_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "displayOrder": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated envelope"
          },
          "404": {
            "description": "ENVELOPE_NOT_FOUND"
          },
          "409": {
            "description": "ENVELOPE_NAME_DUPLICATE"
          }
        },
        "summary": "Rename or change display order",
        "tags": [
          "Envelopes"
        ]
      }
    },
    "/api/v1/envelopes/{id}/archive": {
      "post": {
        "operationId": "EnvelopesController_archive_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived status or ENVELOPE_NOT_EMPTY error"
          }
        },
        "summary": "Archive envelope with zero balance",
        "tags": [
          "Envelopes"
        ]
      }
    },
    "/api/v1/months/{period}/allocations": {
      "put": {
        "operationId": "AllocationsController_save_v1",
        "parameters": [
          {
            "name": "period",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "allocations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d{1,2})?$"
                    }
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "allocations",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Summary and warnings"
          },
          "404": {
            "description": "MONTH_NOT_FOUND or ENVELOPE_NOT_FOUND (unknown or archived envelope)"
          },
          "409": {
            "description": "VERSION_CONFLICT or MONTH_LOCKED"
          },
          "422": {
            "description": "ALLOCATION_EXCEEDS_INCOME"
          }
        },
        "summary": "Save full allocation table for a month",
        "tags": [
          "Allocations"
        ]
      }
    },
    "/api/v1/operations": {
      "get": {
        "operationId": "OperationsController_list_v1",
        "parameters": [
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "expense",
                "transfer",
                "adjustment",
                "initial_balance"
              ],
              "type": "string"
            }
          },
          {
            "name": "envelopeId",
            "required": false,
            "in": "query",
            "description": "Source or destination envelope",
            "schema": {}
          },
          {
            "name": "period",
            "required": false,
            "in": "query",
            "description": "YYYY-MM",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Operations with results, ordered by period and sequence_no",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "monthId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "sequenceNo": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "expense",
                              "transfer",
                              "adjustment",
                              "initial_balance"
                            ]
                          },
                          "sourceEnvelopeId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "destinationEnvelopeId": {
                            "type": "string",
                            "format": "uuid",
                            "nullable": true
                          },
                          "requestedMinor": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "sign": {
                            "type": "string",
                            "enum": [
                              "+",
                              "-"
                            ],
                            "nullable": true
                          },
                          "isInitial": {
                            "type": "boolean"
                          },
                          "comment": {
                            "type": "string",
                            "maxLength": 500,
                            "nullable": true
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "period": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}$"
                          },
                          "result": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "operationId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "coveredMinor": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "uncoveredMinor": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "sourceBalanceBefore": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "sourceBalanceAfter": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "destinationBalanceBefore": {
                                "type": "integer",
                                "minimum": 0,
                                "nullable": true
                              },
                              "destinationBalanceAfter": {
                                "type": "integer",
                                "minimum": 0,
                                "nullable": true
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "operationId",
                              "coveredMinor",
                              "uncoveredMinor",
                              "sourceBalanceBefore",
                              "sourceBalanceAfter",
                              "destinationBalanceBefore",
                              "destinationBalanceAfter",
                              "createdAt",
                              "updatedAt"
                            ],
                            "additionalProperties": false,
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "monthId",
                          "sequenceNo",
                          "type",
                          "sourceEnvelopeId",
                          "destinationEnvelopeId",
                          "requestedMinor",
                          "sign",
                          "isInitial",
                          "comment",
                          "createdAt",
                          "updatedAt",
                          "period",
                          "result"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "operations"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR"
          }
        },
        "summary": "Get operation history",
        "tags": [
          "Operations"
        ]
      },
      "post": {
        "operationId": "OperationsController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "expense",
                      "transfer",
                      "adjustment",
                      "initial_balance"
                    ]
                  },
                  "sourceEnvelopeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "destinationEnvelopeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  "sign": {
                    "type": "string",
                    "enum": [
                      "+",
                      "-"
                    ]
                  },
                  "comment": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "sourceEnvelopeId",
                  "amount",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operation, its result, the new month summary and warnings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "operation": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "monthId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "sequenceNo": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "expense",
                                "transfer",
                                "adjustment",
                                "initial_balance"
                              ]
                            },
                            "sourceEnvelopeId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "destinationEnvelopeId": {
                              "type": "string",
                              "format": "uuid",
                              "nullable": true
                            },
                            "requestedMinor": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "sign": {
                              "type": "string",
                              "enum": [
                                "+",
                                "-"
                              ],
                              "nullable": true
                            },
                            "isInitial": {
                              "type": "boolean"
                            },
                            "comment": {
                              "type": "string",
                              "maxLength": 500,
                              "nullable": true
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "updatedAt": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "required": [
                            "id",
                            "monthId",
                            "sequenceNo",
                            "type",
                            "sourceEnvelopeId",
                            "destinationEnvelopeId",
                            "requestedMinor",
                            "sign",
                            "isInitial",
                            "comment",
                            "createdAt",
                            "updatedAt"
                          ],
                          "additionalProperties": false
                        },
                        "result": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "operationId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "coveredMinor": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "uncoveredMinor": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "sourceBalanceBefore": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "sourceBalanceAfter": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "destinationBalanceBefore": {
                              "type": "integer",
                              "minimum": 0,
                              "nullable": true
                            },
                            "destinationBalanceAfter": {
                              "type": "integer",
                              "minimum": 0,
                              "nullable": true
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "updatedAt": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "required": [
                            "id",
                            "operationId",
                            "coveredMinor",
                            "uncoveredMinor",
                            "sourceBalanceBefore",
                            "sourceBalanceAfter",
                            "destinationBalanceBefore",
                            "destinationBalanceAfter",
                            "createdAt",
                            "updatedAt"
                          ],
                          "additionalProperties": false
                        },
                        "summary": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "period": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}$"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "draft",
                                "open",
                                "closed",
                                "reopened"
                              ]
                            },
                            "incomeMinor": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "version": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "totalAllocatedMinor": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "freeFundsMinor": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "id",
                            "period",
                            "status",
                            "incomeMinor",
                            "version",
                            "totalAllocatedMinor",
                            "freeFundsMinor"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "operation",
                        "result",
                        "summary"
                      ],
                      "additionalProperties": false
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data",
                    "warnings"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "MONTH_NOT_FOUND or ENVELOPE_NOT_FOUND"
          },
          "409": {
            "description": "VERSION_CONFLICT, MONTH_LOCKED, TRANSFER_EXCEEDS_BALANCE or archived envelope"
          },
          "422": {
            "description": "VALIDATION_ERROR"
          }
        },
        "summary": "Create an operation in the current working month",
        "tags": [
          "Operations"
        ]
      }
    },
    "/api/v1/dashboard/monthly": {
      "get": {
        "operationId": "ReportingController_monthlyDashboard_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Summary, envelopes, warnings"
          }
        },
        "summary": "Monthly dashboard",
        "tags": [
          "Reporting"
        ]
      }
    },
    "/api/v1/analytics/yearly": {
      "get": {
        "operationId": "ReportingController_yearlyAnalytics_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Three required reports"
          }
        },
        "summary": "Yearly analytics",
        "tags": [
          "Reporting"
        ]
      }
    }
  },
  "info": {
    "title": "Family Budget API",
    "description": "API for family budget application — months, envelopes, allocations, operations",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
