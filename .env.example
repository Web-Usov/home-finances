# Root environment variables. Copy to `.env` (git-ignored); never commit real secrets.
# docker compose reads `.env` from the repository root; every value below is also the built-in default.

# --- Docker Compose: database (change the password for anything but a local machine) ---
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=family_budget

# --- Docker Compose: host ports (container-internal ports are fixed) ---
POSTGRES_PORT=5432
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# --- Local development without Docker for the app (pnpm dev; DB from `pnpm db:up`) ---
# Compose builds its own DATABASE_URL (host `postgres`); this one is for apps/api run on the host.
DATABASE_URL=postgresql://budget:budget@localhost:5432/family_budget?schema=public
API_PORT=3000
API_HOST=0.0.0.0

# Mobile / web client in dev: API origin without `/api`. The compose `web` image is built with
# `same-origin` (page origin + /api proxy), so this does not apply to it.
EXPO_PUBLIC_API_URL=http://localhost:3000
